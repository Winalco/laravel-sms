{
    "name": "winalco/laravel-sms",
    "description": "Client Laravel pour le relay SMS Winalco (envoi, suivi, webhook signé).",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/support": "^10.0",
        "illuminate/database": "^10.0",
        "illuminate/http": "^10.0",
        "illuminate/queue": "^10.0",
        "illuminate/routing": "^10.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Winalco\\Sms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Winalco\\Sms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Winalco\\Sms\\SmsServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
